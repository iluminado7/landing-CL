---
// Versión estática (Fase 2). En la Fase 5 se suman las capas de la puerta
// (lector rojo → verde → se abre → destello) detrás del contenido.
import Boton from '../components/ui/Boton.astro';
import { SOLICITAR_SERVICIO, whatsapp, telefonoPrincipal } from '../data/contacto.js';
---
<section class="cierre" id="solicitar" aria-labelledby="cierre-titulo">
  <div class="contenedor cierre__contenido">
    <h2 class="cierre__titulo" id="cierre-titulo">¿Qué más estás esperando <span class="oro">para contactarnos?</span></h2>
    <p class="cierre__texto">Completá el formulario y un asesor se comunica con vos para avanzar con tu instalación.</p>
    <Boton href={SOLICITAR_SERVICIO} grande flecha class="cierre__boton" track="clic_solicitar_servicio" ubicacion="cierre">Solicitar servicio</Boton>
    <p class="cierre__alternativa">
      O escribinos por <a href={whatsapp.href} target="_blank" rel="noopener" data-track="clic_whatsapp" data-ubicacion="cierre">WhatsApp</a>{' '}
      o llamanos al <a href={telefonoPrincipal.href} data-track="clic_telefono" data-ubicacion="cierre">{telefonoPrincipal.texto}</a>
    </p>
  </div>
</section>

<style>
  .cierre {
    position: relative;
    overflow: hidden;
    padding: calc(var(--seccion-y) * 1.1) 0;
    background:
      radial-gradient(ellipse 55% 70% at 50% 100%, rgba(245, 190, 0, 0.12), transparent 70%),
      var(--negro);
    text-align: center;
  }

  .cierre__contenido {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .cierre__titulo {
    max-width: 820px;
    margin-bottom: 16px;
    font-size: clamp(30px, 7vw, 54px);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .cierre__titulo .oro { display: block; }

  .cierre__texto {
    max-width: 520px;
    margin-bottom: 32px;
    color: var(--texto-tenue);
    font-size: 16px;
  }

  .cierre :global(.cierre__boton) {
    min-width: min(100%, 320px);
    min-height: 60px;
    font-size: 15px;
    box-shadow: 0 10px 30px rgba(245, 190, 0, 0.2);
  }

  .cierre__alternativa {
    margin-top: 20px;
    color: var(--texto-suave);
    font-size: 14px;
  }

  .cierre__alternativa a {
    white-space: nowrap;
    color: var(--texto);
    font-weight: 600;
    text-decoration-color: var(--oro-borde-fuerte);
    text-underline-offset: 3px;
    transition: color var(--rapido);
  }

  .cierre__alternativa a:hover { color: var(--oro); }
</style>
