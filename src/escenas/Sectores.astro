---
// Versión estática (Fase 2): grilla. En la Fase 5 pasa a pista horizontal
// pineada en escritorio (.sectores__pista).
import CabeceraSeccion from '../components/ui/CabeceraSeccion.astro';
import { sectores } from '../data/sectores.js';
---
<section class="seccion seccion--alterna sectores" id="sectores" aria-labelledby="sectores-titulo">
  <div class="contenedor">
    <CabeceraSeccion centro badge="Nuestros clientes" id="sectores-titulo"
      subtitulo="Implementamos sistemas a medida para las necesidades de cada establecimiento. Elegí el tuyo.">
      Soluciones para <span class="oro">cada tipo de cliente</span>
    </CabeceraSeccion>

    <ul class="sectores__pista">
      {sectores.map((s) => (
        <li class:list={['sector', { 'sector--principal': s.principal }]}>
          <a class="sector__link" href={s.href} data-track="clic_sector" data-ubicacion={s.id}>
            <span class="icono-trazo sector__icono" aria-hidden="true">
              <svg viewBox="0 0 24 24" set:html={s.icono} />
            </span>
            <span class="sector__cuerpo">
              <span class="sector__titulo">{s.titulo}</span>
              <span class="sector__texto">{s.texto}</span>
              <span class="sector__mas">Ver solución</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .sectores__pista {
    display: grid;
    gap: 16px;
  }

  .sector {
    position: relative;
    overflow: hidden;
    background: var(--superficie);
    border: 1px solid var(--borde);
    border-radius: var(--radio);
    transition: border-color var(--medio), transform var(--rapido);
  }

  /* Línea dorada inferior que se dibuja en hover */
  .sector::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 3px;
    background: var(--oro);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s ease;
  }

  .sector__link {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    height: 100%;
    padding: 24px;
    color: inherit;
    text-decoration: none;
  }

  .sector__link:focus-visible { outline-offset: -3px; }

  .sector__icono {
    width: 48px;
    height: 48px;
  }

  .sector__cuerpo {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-height: 100%;
  }

  .sector__titulo {
    font-size: 17px;
    font-weight: 800;
    line-height: 1.3;
  }

  .sector__texto {
    flex: 1;
    color: var(--texto-tenue);
    font-size: 14px;
    line-height: 1.55;
  }

  .sector__mas {
    margin-top: 6px;
    color: var(--oro);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: letter-spacing var(--rapido);
  }

  .sector__mas::after { content: ' →'; }

  /* Consorcios: el cliente principal, tarjeta destacada */
  .sector--principal {
    background: linear-gradient(135deg, rgba(245, 190, 0, 0.1), transparent 60%), var(--superficie);
    border-color: var(--oro-borde);
  }

  .sector--principal .sector__titulo { font-size: 20px; }

  @media (hover: hover) {
    .sector:hover {
      border-color: rgba(245, 190, 0, 0.4);
      transform: translateY(-3px);
    }

    .sector:hover::after { transform: scaleX(1); }
    .sector:hover .sector__icono { background: var(--oro-fondo-fuerte); }
    .sector:hover .sector__mas { letter-spacing: 0.14em; }
  }

  @media (min-width: 640px) {
    .sectores__pista { grid-template-columns: repeat(2, 1fr); }
    .sector--principal { grid-column: 1 / -1; }
  }

  @media (min-width: 1024px) {
    .sectores__pista { grid-template-columns: repeat(3, 1fr); }
    .sector--principal .sector__link { align-items: center; gap: 24px; padding: 32px; }
    .sector--principal .sector__icono { width: 64px; height: 64px; }
    .sector--principal .sector__icono svg { width: 32px; height: 32px; }
    .sector--principal .sector__titulo { font-size: 24px; }
    .sector--principal .sector__texto { font-size: 15px; max-width: 640px; }
  }
</style>
